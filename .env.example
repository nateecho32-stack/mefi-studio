# Mefi's Studio AI+ — environment variables the app reads.
#
# Nothing here is required. Keys are normally entered in Settings & connections
# and stored encrypted in the OS keystore. Studio reads its own MEFI_STUDIO_*_KEY
# variables every time it needs a key, and one that is set wins over the key
# saved in Settings, so a host with no keystore can run on them alone. The
# headless `electron . --set-*-key` commands are the one-time path: they copy
# the variable into the keystore. Unset it afterwards, or it keeps overriding
# whatever you later save in Settings.
#
# Studio does NOT load this file automatically. Set the variables in your shell
# (PowerShell: $env:MEFI_STUDIO_REPO = "C:\path"), or copy this file to .env and
# source it with your own tooling. .env is git-ignored.

# --- Where Studio works -------------------------------------------------------
# Open this repository directly instead of the project chooser (headless/dev).
#MEFI_STUDIO_REPO=C:\Projects\my-app
# Ruins Runner game checkout (optional integration; a sibling "2d Trippy Hell"
# folder is picked up automatically when present).
#MEFI_STUDIO_GAME_ROOT=C:\Projects\2d Trippy Hell
# Discord Server Styler checkout for Settings' Server Styler card (optional; a
# sibling "discord-server-styler" folder is picked up automatically).
#MEFI_STYLER_ROOT=C:\Projects\discord-server-styler
# Move the board's SQLite authority out of a synced folder (OneDrive locks).
#MEFI_STUDIO_BOARD_DB=C:\Users\me\AppData\Local\mefi-studio\board.db
# Port for the browser fallback (`npm run start:web`). Default 4173.
#MEFI_STUDIO_PORT=4173
# Give every worker run its own git worktree (opt-in), so parallel runs stop
# sharing one .git/index. A run starts from HEAD, so uncommitted work in the
# shared tree is invisible to it until it lands.
#MEFI_STUDIO_WORKTREE_RUNS=1
# With worktree runs on and no node_modules in the repository root, a run falls
# back to `npm ci` in its checkout. 0 skips that install.
#MEFI_STUDIO_WORKTREE_NPM_CI=0

# --- Keys for headless setup (paired with `electron . --set-*-key`) -----------
#MEFI_STUDIO_KEY=            # OpenCode Go            → --set-key
#MEFI_STUDIO_ZAI_KEY=        # z.ai coding plan       → --set-zai-key
#MEFI_STUDIO_CUSTOM_KEY=     # custom OpenAI-compatible endpoint → --set-custom-key
#MEFI_STUDIO_GATEWAY_KEY=    # Vercel AI Gateway (Jev) → --set-gateway-key
#MEFI_STUDIO_JEV_KEY=        # TypeSafe Jev API       → --set-jev-key
#MEFI_STUDIO_ZEN_KEY=        # OpenCode Zen (Jev)     → --set-zen-key
#MEFI_STUDIO_OPENROUTER_KEY= # OpenRouter (Jev)       → --set-openrouter-key
# Jev classifier route: vercel | typesafe | zen | openrouter
#MEFI_JEV_ROUTE=zen
# Base URL for the selected Jev route, whichever it is (despite the name).
#MEFI_AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
# Replace the route's pinned Jev model. Only a Jev model id is accepted.
#MEFI_JEV_MODEL=jev-1.13.0
# Per-request timeout in ms (1000-60000, default 15000).
#MEFI_JEV_TIMEOUT_MS=15000
# How many characters of application state one question may carry
# (200-60000, default 8000).
#MEFI_JEV_MAX_STATE_CHARS=8000

# --- Release updates ----------------------------------------------------------
# Read-only token for a private release repository (or let Studio reuse
# `gh auth token`).
#MEFI_STUDIO_GITHUB_TOKEN=
# Override the "owner/repo" the updater polls.
#MEFI_STUDIO_UPDATE_REPO=nateecho32-stack/mefi-studio
# 1 turns off live source updates for a fixed checkout (a container, a service
# host): no polling the source tree, no restart when main.cjs changes.
#MEFI_STUDIO_NO_LIVE_UPDATE=1

# --- Community ----------------------------------------------------------------
# Client id of the "Mefi Studio Link" Discord application (a public client),
# for Link my Discord in Settings › Community. Set, it wins over CLIENT_ID in
# scripts/community.cjs, so a maintainer can test an app before committing the
# id. Digits only: any other value turns linking off, even with CLIENT_ID set.
#MEFI_STUDIO_DISCORD_CLIENT_ID=

# --- Diagnostics --------------------------------------------------------------
# Raise the machine gauge's memory-warning threshold (MB) on a big box.
#MEFI_STUDIO_MEMORY_WARN_OVERRIDE=
