# Dependencies and generated portable application
node_modules/
dist/

# Only the model catalog belongs in source control. Keep tasks, conversations,
# assistant state, databases, caches and atomic-write leftovers local.
# Explicit sensitive-state rules also protect these if the catalog allowlist grows.
data/eyes-assistant.json
data/machine-status.json
data/resource-manager.json
data/*
!data/curated.json
!data/models.json
tools/logs/
.local-migration/
.codex-remote-attachments/

# Local credentials, environment and editor/runtime output
.env
.env.*
!.env.example
# Machine credentials and accidental portable-auth exports must stay local.
auth.json
community-auth.json
/settings.json
credentials.json
.credentials.json
api-keys.json
secrets.json
.secrets/
secrets/
.grok/
*.pem
*.key
*.log
*.db
*.db-shm
*.db-wal
*.tmp-*
__pycache__/
*.pyc
.DS_Store
Thumbs.db
desktop.ini
.vscode/
*.lnk

# Local-only Claude Code config (preview launch.json, worktrees, personal
# settings) and the untracked site. The shared SessionStart sync hook in
# .claude/settings.json is tracked so every PC runs it, and so are the
# project skills in .claude/skills (commit-check), which Claude Code loads and
# Studio's Agents › Setup › Skills lists for its builders.
.claude/*
!.claude/settings.json
!.claude/skills/
website/

# Editor swap and merge leftovers
.idea/
*.swp
*.swo
*.orig
*.rej

# Built alongside renderer/booklet.html by scripts/build-booklet.mjs; consumed by
# the perf-render fixture to resolve error locations. Regenerated on every build.
renderer/booklet.sources.json
