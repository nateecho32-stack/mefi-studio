{
  "name": "mefi-studio",
  "productName": "Mefi's Studio AI+",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A personal multi-project workspace with an AI companion, agent task loop, and visible work results.",
  "main": "main.cjs",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "start:web": "node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "data": "node scripts/refresh-models.mjs",
    "data:offline": "node scripts/refresh-models.mjs --offline",
    "build-booklet": "node scripts/build-booklet.mjs",
    "check:targets": "node scripts/check-targets.mjs",
    "check:specs": "node scripts/spec-collisions.mjs",
    "check:css": "node scripts/check-css.mjs",
    "check:css:merge": "node scripts/check-css.mjs --merge",
    "check:css:unused": "node scripts/check-css.mjs --unused",
    "check": "node scripts/check-targets.mjs && node scripts/spec-collisions.mjs && node scripts/check-css.mjs --merge && node scripts/check-css.mjs --unused && node scripts/check-syntax.mjs",
    "reconcile-board": "node scripts/reconcile-board.mjs",
    "policy-lab": "node scripts/policy-lab.mjs",
    "jev:status": "electron . --jev-status",
    "jev:models": "electron . --jev-models",
    "jev:probe": "electron . --jev-probe",
    "capture": "electron . --capture",
    "audit": "node scripts/auditor.mjs",
    "icon": "node scripts/make-icon.mjs",
    "test": "node scripts/run-node-tests.mjs && python -m unittest discover -s tools -p \"test_mefi_studio_*.py\" && node tools/test_normalized_path_lock.mjs",
    "package": "node scripts/package-portable.mjs",
    "package:release": "npm run build-booklet && node scripts/package-portable.mjs --release"
  },
  "devDependencies": {
    "electron": "44.4.1"
  }
}
