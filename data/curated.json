    },
    "notes": [
      "Usage limits are dollar-based: $12 per 5 hours, $30 per week, $60 per month across the plan.",
      "Each model also has its own monthly pool; 5h = 20% of it and week = 50% of it.",
      "DeepSeek V4.x runs peak/off-peak pricing; peak is 01:00-04:00 and 06:00-10:00 UTC Mon-Fri.",
      "When a limit is reached you can keep using free models, or fall back to a Zen balance if enabled."
    ]
  },
  "taskPresets": [
    {
      "id": "everyday",
      "name": "Everyday driver",
      "description": "Routine edits, feature work, agent loops where cost and throughput matter but quality must stay good.",
