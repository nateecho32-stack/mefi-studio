        "quality": 0.5,
        "context": 0.2,
        "speed": 0.1,
        "cost": 0.15,
        "privacy": 0.05
      },
      "short": "Hard"
    },
    {
      "id": "bulk",
      "name": "Bulk edits & test fixes",
      "description": "Mechanical changes across many files; volume beats brilliance.",
      "weights": {
        "cost": 0.4,
        "speed": 0.3,
        "quality": 0.2,
        "context": 0.1
      },
      "short": "Bulk"
    },
    {
      "id": "longctx",
      "name": "Long-context work",
      "description": "Whole-repo reads, long transcripts, multi-file audits.",
      "weights": {
        "context": 0.4,
        "quality": 0.25,
        "cost": 0.25,
        "speed": 0.1
      },
      "short": "Long ctx"
    },
    {
      "id": "vision",
      "name": "Vision / screenshots",
      "description": "Screenshot-driven UI work and image input; only models accepting image input qualify.",
      "requiresModality": "image",
      "weights": {
        "quality": 0.4,
        "cost": 0.3,
        "speed": 0.2,
        "context": 0.1
      },
      "short": "Vision"
    },
    {
      "id": "chat",
      "name": "Quick chat / small asks",
      "description": "One-off questions, commit messages, tiny scripts.",
      "weights": {
        "cost": 0.45,
        "speed": 0.35,
        "quality": 0.2
      },
      "short": "Chat"
    }
  ],
  "privacyScores": {
    "no-train-0day": 1,
