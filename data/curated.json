        "cost": 0.35,
        "speed": 0.25,
        "quality": 0.25,
        "context": 0.1,
        "privacy": 0.05
      },
      "short": "Everyday"
    },
    {
      "id": "hard",
      "name": "Hard problem / architecture",
      "description": "Design work, gnarly refactors, debugging where a wrong answer costs more than tokens.",
